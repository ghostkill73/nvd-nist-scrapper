#!/usr/bin/env bash
# NIST NVD CVE API docs: https://nvd.nist.gov/developers/vulnerabilities

# TODO: Add CPE search
# TODO: Add --limit-date option

# shellcheck disable=SC2178

set -euo pipefail

[[ -n "$(type -P jq)" ]] || {
	echo "$0: ERROR: 'jq' command not found."
	exit 1
}

########################################
# CONFIG
########################################

NVD_API_CVE="https://services.nvd.nist.gov/rest/json/cves/2.0/"
CONFIG_DEFAULT_OUTFILE="nvd_dump_out.json"

########################################
# UTILS
########################################

log() {
	printf '[%(%H:%M:%S)T] %s\n' "-1" "$@" >&2
}

msg() {
	printf '%b\n' "$@" >&2
}

die() {
	msg "$0: ERROR: $*"
	exit 1
}

unix_time2date() {
	TZ=UTC command date -d @"$1" "+%Y-%m-%dT00:00:00.000"
}

date2unix_time() {
	TZ=UTC command date -d "$1" "+%s"
}

file_size() {
	# shellcheck disable=SC2046
	set -- $(command du -h "$1")
	echo "$1"
}

########################################
# MESSAGES
########################################

display_default_message() {
	msg "$0: missing options" \
		"try '$0 --help' for more information."
	exit 1
}

display_invalid_option() {
	msg "$0: invalid option -- '$1'"
	msg "Try '$0 --help' for more information."
	exit 1
}

display_help() {
	msg \
	"Usage: $0 [OPTIONS]... [KEYWORDS]..." \
	"Fetches CVEs from the NIST National Vulnerability Database (NVD)." \
	"" \
	"Examples: " \
	"  $0 --keyword linux -t 1" \
	"  $0 --cache-dir tmp --keyword freebsd -t 3 -o nvd_freebsd.json" \
	"" \
	"Options:" \
	"  --cache-dir           set the cache directory" \
	"  --clear-caches        clear the cache directory" \
	"  --help, -h            display this help message" \
	"  --keyword, -k         keyword to search for" \
	"  --output, -o          JSON output file" \
	"  --search-times, -t    number of times to jump over date ranges (4 months each)" \
	"" \
	"Repository: https://github.com/ghostkill73/nvd-nist-scrapper | WTFPLv2"
	exit 0
}

########################################
# RUN
########################################

fetch_nvd_cves_api() {
	local pub_start="$1" pub_end="$2"
	command curl -fsSL -G "$NVD_API_CVE" \
		--data-urlencode "pubStartDate=$pub_start" \
		--data-urlencode "pubEndDate=$pub_end" \
		--data-urlencode "keywordSearch=$KEYWORD"
}

fetch_nvd_cves() {
	local -n files_ref="$1"

	local actual_date="$EPOCHSECONDS"

	local -i i w_new w_old
	local cache_file window_old window_new
	for(( i=1; i<=SEARCH_TIMES; i++ )) {
		w_new=$(( actual_date - (i-1) * _120_DAYS ))
		w_old=$(( w_new - _120_DAYS ))

		(( w_old <= LIMIT_DATE )) && break
		(( w_new < LIMIT_DATE && (w_new = LIMIT_DATE) )) || :

		cache_file="$CACHE_DIR/nvd_dump_${KEYWORD_CLEAN}.${i}.json"

		if ! [[ -e "$cache_file" ]]; then
			window_old=$(unix_time2date "$w_old")
			window_new=$(unix_time2date "$w_new")

			log "fetching data: range=${window_old}-${window_new} | keyword='$KEYWORD' | cache_file=$cache_file"

			fetch_nvd_cves_api "$window_old" "$window_new" "$KEYWORD" > "$cache_file"
			command sleep "$WAIT_SECONDS"
		else
			log "cache: $cache_file"
		fi

		files_ref+=("$cache_file")

		(( w_new == LIMIT_DATE )) && break
	}

	log "files: ${files_ref[*]}"
}

catch_total_results() {
	local -n files_ref="$1" total_ref="$2"

	local file v_tr
	for file in "${files_ref[@]}"; do
		v_tr=$(jq -r .totalResults "$file")
		total_ref+=${v_tr}

		log "$file -> size: $(file_size "$file")"
		log "$file -> totalResults: $v_tr"
	done
}

catch_vulns() {
	local -n files_ref="$1" vulns_ref="$2"

	local file_index
	for file_index in "${!files_ref[@]}"; do
		(( file_index == 0 )) && {
			vulns_ref+=".[0].vulnerabilities"
			continue
		}

		vulns_ref+=" + .[$file_index].vulnerabilities"

		(( file_index + 1 == "${#files_ref[@]}" )) && break
	done
}

main() {
	log "output: $OUT_FILE"
	log "cache dir: $CACHE_DIR"
	log "search times: $SEARCH_TIMES"

	command mkdir -p "$CACHE_DIR" 2>&-

	local files=()
	local -i total_results=0
	local vulns=""

	fetch_nvd_cves files
	catch_total_results files total_results
	catch_vulns files vulns

	command jq \
		--argjson tr "$total_results" \
		-s "{
			startIndex: 0,
			totalResults: \$tr,
			format: .[0].format,
			version: .[0].version,
			timestamp: now | todate,
			vulnerabilities: ($vulns)
		}" \
		"${files[@]}" > "$OUT_FILE"

	log "$OUT_FILE -> size: $(file_size "$OUT_FILE")"
	log "$OUT_FILE -> totalResults: $total_results"

	log "done."
}

(( $# == 0 )) && display_default_message

: "${OUT_FILE:=$CONFIG_DEFAULT_OUTFILE}"
: "${CACHE_DIR:=${TMPDIR:-/tmp}/nvd-dump}"
: "${SEARCH_TIMES:=1}"
: "${KEYWORD:=}"
: "${WAIT_SECONDS:=10}"

while (( $# > 0 )); do
	case "$1" in
	--cache-dir) CACHE_DIR="$2" ;;
	--clear-caches|-c) command rm -rfv "$CACHE_DIR"; exit $? ;;
	--help|-h) display_help ;;
	--keyword|-k) KEYWORD="$2" ;;
	--output|-o) OUT_FILE="$2" ;;
	--search-times|-t) declare -i SEARCH_TIMES=$2 ;;
	--) break ;;
	*) display_invalid_option "$1" ;;
	esac

	shift 2
done

[[ -z "$KEYWORD" ]] && {
	die "keyword not defined. use --keyword option."
}

KEYWORD_CLEAN="${KEYWORD//[!0-9a-zA-Z]/_}"
LIMIT_DATE=$(date2unix_time "1999-10-01") # first NVD CVE
_120_DAYS=$(( 120 * 24 * 60 * 60 ))

main
